# Copie para .env (ignorado pelo git) e preencha só o que for usar.
# Sem nenhuma chave, todos os testes offline e de Docker funcionam.

# --- Testes reais (uv run pytest --live) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# PINECONE_API_KEY=

# Provedor usado pelos exemplos com LangChain (padrão: o primeiro com chave).
# LLM_PROVIDER=anthropic

# Modelos (padrões em labs/shared/settings.py).
# OPENAI_MODEL=gpt-6-luna
# ANTHROPIC_MODEL=claude-haiku-5-5
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Observabilidade: LangSmith ---
# LANGSMITH_API_KEY=

# --- Observabilidade: Langfuse local (infra/langfuse.compose.yml) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev
# LANGFUSE_BASE_URL=http://localhost:13000
